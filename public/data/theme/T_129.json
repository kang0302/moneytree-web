  "changelog": [
   {
    "date": "2026-08-04",
    "kind": "보강",
    "title": "2궤도 관계 엣지 추가",
    "detail": "테마 내 자산 간 공급/경쟁/파트너/투자 관계 5건 백필(리서치 기반)."
   },
   {
    "date": "2026-07-11",
    "kind": "보강",
    "title": "자산별 테마관점 CHR 정의",
    "detail": "전 자산에 테마 내 역할·포지션 기반 CHR을 정의했다."
   },
   {
    "date": "2026-07-11",
    "kind": "보강",
    "title": "엣지 근거 구체 백필 + 2026 이벤트",
    "detail": "전 엣지 근거(호버 박스)를 종목별 사업·관계 사실로 구체화하고 2026 이벤트 2건을 추가했다."
   }
  ],
  "description": "휴젤·메디톡스·대웅제약·이니바이오·종근당바이오 등 K-보톡스 빅캡. 미국·유럽 BLA 승인·중국 정식 진입·license-out·차세대 리퀴드 톡신 사이클이 multiyear 동인. 리프팅레이저시술확산·의료관광확대·K-뷰티확산 등 거시 변수가 테마 성과의 핵심 동인으로 작용한다. 구성종목은 국내헬스케어ETF·의료기기소부장ETF·미용레이저초음파·리쥬란미용의료 등의 특성으로 차별화된다. 경쟁·공급·협력 등 7건의 종목 간 관계로 밸류체인 내 상호작용을 함께 표시한다. 종목별 브리핑 카드와 연도별 이벤트 DB로 테마의 맥락과 변동요인을 확인할 수 있다."
 },

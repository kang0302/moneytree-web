  "sources": [],
  "changelog": [
   {
    "date": "2026-08-04",
    "kind": "보강",
    "title": "2궤도 관계 엣지 추가",
    "detail": "테마 내 자산 간 공급/경쟁/파트너/투자 관계 7건 백필(리서치 기반)."
   },
   {
    "date": "2026-07-12",
    "kind": "보강",
    "title": "자산별 테마관점 CHR 정의",
    "detail": "전 자산에 테마 내 역할·포지션 기반 CHR을 정의했다."
   },
   {
    "date": "2026-07-12",
    "kind": "보강",
    "title": "엣지 근거 구체 백필 + 2026 이벤트",
    "detail": "전 엣지 근거(호버 박스)를 종목·관계 사실로 구체화하고 2026 이벤트 2건을 추가했다."
   },
   {
    "date": "2026-07-10",
    "kind": "변경",
    "title": "매크로는 테마에만 연결",
    "detail": "개별 자산·BF에 직접 걸려 있던 매크로 IMPACTS 엣지를 테마 레벨로 정리(repoint 2, 중복제거 13)했다."
   },
   {
    "date": "2026-08-05",
    "kind": "관계",
    "title": "EXPOSED_TO ETF 연결",
    "detail": "테마 구성종목과 겹침이 높은 상장 ETF를 EXPOSED_TO로 연결하고 브리핑카드·근거를 부착했다."
   }
  ],
  "description": "한·중 외교 회복·관광·면세·화장품 노출군 — 호텔신라·아모레퍼시픽·LG생활건강·하나투어. 시진핑 방한·한·중 정상회담·단체관광 재개가 단기 모멘텀. KODEX K콘텐츠·TIGER 화장품 등 ETF로도 익스포저를 확장한다. 비자면제여행규제·게임판호규제·한한령 등 거시 변수가 테마 성과의 핵심 동인으로 작용한다. 밸류체인은 K-콘텐츠·K-화장품 등 사업영역으로 이어진다. 경쟁·공급·협력 등 7건의 종목 간 관계로 밸류체인 내 상호작용을 함께 표시한다."
 },
